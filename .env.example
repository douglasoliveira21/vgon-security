# ---- Postgres (docker-compose.dev.yml) ----
POSTGRES_USER=vgon
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=vgon_security

# ---- API (apps/api) ----
DATABASE_URL=postgresql://vgon:change-me-dev-only@localhost:5432/vgon_security?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Secrets: generate distinct high-entropy values per environment, e.g. `openssl rand -base64 48`.
# Never commit real values or reuse dev secrets in staging/production.
JWT_ACCESS_SECRET=dev-web-access-secret-change-me
AGENT_JWT_SECRET=dev-agent-access-secret-change-me

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
