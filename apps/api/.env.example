DATABASE_URL=postgresql://vgon:change-me-dev-only@localhost:5432/vgon_security?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-web-access-secret-change-me
AGENT_JWT_SECRET=dev-agent-access-secret-change-me

# Optional: without these, password-reset/invite emails are logged instead of sent (see EmailService).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=change-me
# SMTP_FROM=VGON Security+ <no-reply@yourdomain.com>

# Optional: without this, the login captcha check is skipped entirely (see TurnstileService).
# Get a site key + secret key from the Cloudflare dashboard (Turnstile) — the site key goes in
# apps/web's NEXT_PUBLIC_TURNSTILE_SITE_KEY, this secret key stays server-side only.
# TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000
