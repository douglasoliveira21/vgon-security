{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "ApiBaseUrl": "http://localhost:4000/api/v1",
    "ProvisioningToken": "",
    "HeartbeatIntervalSeconds": 60,
    "EventUploadIntervalSeconds": 15,
    "EventUploadBatchSize": 100,
    "ProcessCollectorEnabled": true,
    "ProcessCollectorPollIntervalSeconds": 5,
    "SuspiciousProcessNames": ["mimikatz.exe", "psexec.exe", "procdump.exe", "pwdump.exe"],
    "BrowserCollectorEnabled": true,
    "BrowserCollectorPollIntervalSeconds": 30,
    "BrowserUrlPolicy": "SANITIZED_URL",
    "SensitiveUrlParams": ["token", "session", "password", "pwd", "secret", "key", "auth", "sig", "signature", "credential"],
    "FileCollectorEnabled": true,
    "FileWatchFolders": ["Desktop", "Documents", "Downloads"],
    "FileExcludedExtensions": [".tmp", ".temp", ".crdownload", ".partial", ".log", ".ds_store"],
    "FileChangeDebounceSeconds": 2,
    "UsbCollectorEnabled": true,
    "UsbCollectorPollIntervalSeconds": 5,
    "UsbDefaultPolicy": "MONITOR",
    "UsbAllowlist": [],
    "PrinterCollectorEnabled": true,
    "PrinterCollectorPollIntervalSeconds": 5,
    "HardwareCollectorEnabled": true,
    "HardwareCollectorIntervalSeconds": 21600,
    "SoftwareCollectorEnabled": true,
    "SoftwareCollectorIntervalSeconds": 3600,
    "SecurityCollectorEnabled": true,
    "SecurityCollectorIntervalSeconds": 1800,
    "ScreenshotCollectorEnabled": true,
    "ScreenshotIntervalSeconds": 60,
    "RemoteActionPollIntervalSeconds": 30,
    "ScreenViewFrameIntervalMs": 2000,
    "ScreenViewMaxDurationSeconds": 900,
    "UpdatesEnabled": true,
    "UpdateChannel": "STABLE",
    "UpdateCheckIntervalSeconds": 21600
  }
}
